getpid()
{
        local process="$1"

        local pids="$(pidof -x "$process")"

        local displayNumber="$(echo $DISPLAY \
                | awk 'BEGIN { FS = "[:.]" } { print $2 }')"

        ps e -p "$pids" \
	                | awk -v n="$displayNumber" \
        	                '$0 ~ " DISPLAY=:" n "[\n .]" { print $1 }'
}

getejecttray()
{
        local process="i2kejtray"

        local pids="$(pidof -x "$process")"

        local displayNumber="$(echo $DISPLAY \
                | awk 'BEGIN { FS = "[:.]" } { print $2 }')"

        ps e -p "$pids" \
	                | awk -v n="$displayNumber" \
        	                '$0 ~ " DISPLAY=:" n "[\n .]" { print $1 }'
}

