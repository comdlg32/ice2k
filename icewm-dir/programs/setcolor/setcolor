# https://stackoverflow.com/questions/7253235/convert-hexadecimal-color-to-decimal-rgb-values-in-unix-shell-script
middlecolor()
{
	hex1=`echo $1 | tr -d '#' | tr '[:lower:]' '[:upper:]'`  # uppercase-ing
	hex2=`echo $2 | tr -d '#' | tr '[:lower:]' '[:upper:]'`  # uppercase-ing

	a1=`echo $hex1 | cut -c-2`
	b1=`echo $hex1 | cut -c3-4`
	c1=`echo $hex1 | cut -c5-6`

	a2=`echo $hex2 | cut -c-2`
	b2=`echo $hex2 | cut -c3-4`
	c2=`echo $hex2 | cut -c5-6`

	r1=`echo "ibase=16; $a1" | bc`
	g1=`echo "ibase=16; $b1" | bc`
	b1=`echo "ibase=16; $c1" | bc`

	r2=`echo "ibase=16; $a2" | bc`
	g2=`echo "ibase=16; $b2" | bc`
	b2=`echo "ibase=16; $c2" | bc`

	r="$(( (r1 + r2) / 2))"
	g="$(( (g1 + g2) / 2))"
	b="$(( (b1 + b2) / 2))"

	printf "#%02X%02X%02X\n" $r $g $b
}

hextorgb()
{
	hexinput=`echo $1 | tr -d '#' | tr '[:lower:]' '[:upper:]'`  # uppercase-ing
	a=`echo $hexinput | cut -c-2`
	b=`echo $hexinput | cut -c3-4`
	c=`echo $hexinput | cut -c5-6`

	r=`echo "ibase=16; $a" | bc`
	g=`echo "ibase=16; $b" | bc`
	b=`echo "ibase=16; $c" | bc`

	echo $r $g $b
}

